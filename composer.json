{
    "name": "jacyimp/api-platform-rate-limiter",
    "description": "Flexible rate limiting for API Platform",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Jacyimp\\ApiPlatformRateLimiter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jacyimp\\ApiPlatformRateLimiter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "audit": "composer audit",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "test:behaviour": "behat",
        "validate": "composer validate --strict",
        "check": [
            "@validate",
            "@cs",
            "@analyse",
            "@test",
            "@test:behaviour"
        ]
    },
    "authors": [
        {
            "name": "Jacy"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0.4",
        "slevomat/coding-standard": "^8.31",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11.5.50",
        "behat/behat": "^3.32"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
