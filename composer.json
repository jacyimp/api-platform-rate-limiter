{
    "name": "jacyimp/api-platform-rate-limiter",
    "description": "Flexible rate limiting for API Platform",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "api-platform",
        "rate-limit",
        "rate-limiter",
        "laravel",
        "symfony",
        "throttling"
    ],
    "homepage": "https://github.com/jacyimp/api-platform-rate-limiter",
    "support": {
        "issues": "https://github.com/jacyimp/api-platform-rate-limiter/issues",
        "source": "https://github.com/jacyimp/api-platform-rate-limiter"
    },
    "autoload": {
        "psr-4": {
            "JacyImp\\ApiPlatformRateLimiter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JacyImp\\ApiPlatformRateLimiter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "analyse": "phpstan analyse",
        "test": "phpunit",
        "test:behaviour": "behat",
        "check": [
            "@composer validate --strict",
            "@cs",
            "@analyse",
            "@test",
            "@test:behaviour"
        ]
    },
    "authors": [
        {
            "name": "Jacy"
        }
    ],
    "require": {
        "php": "^8.2",
        "api-platform/metadata": "^3.4 || ^4.0",
        "illuminate/cache": "^11.0 || ^12.0 || ^13.0",
        "illuminate/contracts": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/rate-limiter": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/security-core": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0.4",
        "slevomat/coding-standard": "^8.31",
        "phpstan/phpstan": "^2.2.12",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11.5.50",
        "behat/behat": "^3.32",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "paragonie/random_compat": "^9.99",
        "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "JacyImp\\ApiPlatformRateLimiter\\Laravel\\LaravelServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
